# Copy this file to .env and fill in your real Firecrawl API key.
# Get one at https://firecrawl.dev — this POC calls the Firecrawl HTTP API
# directly (not the MCP tools used to build/validate the scrapers in-chat).
FIRECRAWL_API_KEY=fc-...

# Optional. Leave both blank to run with session-only state (nothing persisted).
# Set both to enable persistence: added hotels and every fetch's results are
# saved to Supabase instead of disappearing on refresh. See sql/schema.sql
# for the tables to create, and DEPLOY.md for how to set up a free project.
# SUPABASE_URL is the "Project URL" and SUPABASE_KEY is the "anon public" key,
# both from Project Settings -> API in the Supabase dashboard.
SUPABASE_URL=
SUPABASE_KEY=
